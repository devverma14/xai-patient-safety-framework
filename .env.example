# ==============================================================================
# Environment Configuration Template for XAI Patient Safety Framework
# Copy this file to .env and adjust variables as required for your environment.
# ==============================================================================

# Application Environment (development | staging | production)
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# API Server Host & Port
HOST=0.0.0.0
PORT=8000

# Security & Payload Constraints (20 MB hard ceiling)
MAX_UPLOAD_SIZE_BYTES=20971520
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# OCR Configuration (Leave empty if tesseract is accessible via system PATH)
# Example for Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
# Example for Linux: /usr/bin/tesseract
TESSERACT_CMD=

# Model Weights Paths (Defaults resolve relative to project root)
# PNEUMONIA_MODEL_PATH=models/pneumonia/best_pneumonia_model.pt
# TB_MODEL_PATH=models/tb/best_tb_model.pt
# SKIN_MODEL_PATH=models/skin/binary/best_skin_binary_model.pt
# RETINA_MODEL_PATH=models/retina/best_retina_model.pt
